# Google Gemini API key (required for live Gemma model calls)
GEMINI_API_KEY=

# Gemma model ID on Google Gemini API (mlh.link/gemma), e.g., gemma-4-26b-a4b-it or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Server port (default: 3000)
PORT=3000

# Concurrency limit for model calls (default: 3)
MODEL_CONCURRENCY=3
